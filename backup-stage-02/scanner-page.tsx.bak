"use client";

import { AppShell } from "@/components/app-shell";
import { StatCard } from "@/components/stat-card";
import { age, money, pct } from "@/lib/format";
import { MemeToken, mockTokens } from "@/lib/mock-data";
import { ArrowUpRight, Search, SlidersHorizontal } from "lucide-react";
import Link from "next/link";
import { FormEvent, useMemo, useState } from "react";

type DexPair = {
  chainId?: string;
  pairAddress?: string;
  url?: string;
  baseToken?: { address?: string; name?: string; symbol?: string };
  priceUsd?: string;
  marketCap?: number;
  fdv?: number;
  liquidity?: { usd?: number };
  volume?: Record<string, number>;
  priceChange?: Record<string, number>;
  txns?: Record<string, { buys?: number; sells?: number }>;
};

export default function ScannerPage() {
  const [chain, setChain] = useState("All");
  const [risk, setRisk] = useState("All");
  const [query, setQuery] = useState("");
  const [livePairs, setLivePairs] = useState<DexPair[]>([]);
  const [loading, setLoading] = useState(false);
  const [liveMessage, setLiveMessage] = useState("");

  const tokens = useMemo(() => {
    return mockTokens
      .filter((token) => chain === "All" || token.chain === chain)
      .filter((token) => risk === "All" || token.risk === risk)
      .filter((token) => {
        const q = query.trim().toLowerCase();
        if (!q) return true;
        return (
          token.name.toLowerCase().includes(q) ||
          token.symbol.toLowerCase().includes(q) ||
          token.address.toLowerCase().includes(q)
        );
      })
      .sort((a, b) => b.score - a.score);
  }, [chain, risk, query]);

  const avgScore = Math.round(
    mockTokens.reduce((sum, token) => sum + token.score, 0) / mockTokens.length,
  );
  const highRisk = mockTokens.filter((token) => token.risk === "High").length;
  const volume = mockTokens.reduce((sum, token) => sum + token.volume1h, 0);

  async function liveSearch(event: FormEvent) {
    event.preventDefault();
    const q = query.trim();

    if (q.length < 2) {
      setLiveMessage("Type at least 2 characters or paste a token address.");
      setLivePairs([]);
      return;
    }

    try {
      setLoading(true);
      setLiveMessage("");
      const response = await fetch(`/api/dex/search?q=${encodeURIComponent(q)}`);
      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || "Dexscreener request failed");
      }

      setLivePairs((data.pairs || []).slice(0, 8));
      setLiveMessage(
        data.pairs?.length
          ? `Live Dexscreener results for "${q}"`
          : `No live pair found for "${q}"`,
      );
    } catch (error) {
      setLivePairs([]);
      setLiveMessage(error instanceof Error ? error.message : "Search failed.");
    } finally {
      setLoading(false);
    }
  }

  return (
    <AppShell>
      <div className="border-b border-white/8 px-5 py-5 lg:px-8">
        <div className="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
          <div>
            <div className="text-sm text-emerald-300">Memecoin Intelligence Terminal</div>
            <h1 className="mt-1 text-3xl font-semibold tracking-tight text-white">
              Market Scanner
            </h1>
            <p className="mt-1 max-w-2xl text-sm text-zinc-500">
              Filter early-stage tokens, compare market quality and inspect risk before
              doing deeper research.
            </p>
          </div>

          <div className="rounded-full border border-white/8 bg-white/[0.025] px-4 py-2 text-xs text-zinc-500">
            v0.1 · Foundation build
          </div>
        </div>
      </div>

      <div className="space-y-6 p-5 lg:p-8">
        <section className="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
          <StatCard label="Tracked tokens" value={String(mockTokens.length)} sub="Mock universe" />
          <StatCard label="Average score" value={`${avgScore}/100`} sub="Composite quality score" />
          <StatCard label="1H volume" value={money(volume)} sub="Across tracked tokens" />
          <StatCard label="High risk" value={String(highRisk)} sub="Needs extra verification" />
        </section>

        <section className="rounded-2xl border border-white/8 bg-white/[0.025]">
          <div className="flex flex-col gap-3 border-b border-white/8 p-4 xl:flex-row xl:items-center xl:justify-between">
            <form onSubmit={liveSearch} className="flex min-w-0 flex-1 gap-2">
              <div className="relative min-w-0 flex-1">
                <Search className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-zinc-600" />
                <input
                  value={query}
                  onChange={(e) => setQuery(e.target.value)}
                  placeholder="Search mock data or Dexscreener..."
                  className="h-10 w-full rounded-xl border border-white/8 bg-black/20 pl-10 pr-3 text-sm outline-none transition placeholder:text-zinc-700 focus:border-emerald-400/50"
                />
              </div>
              <button
                type="submit"
                disabled={loading}
                className="rounded-xl bg-white px-4 text-sm font-medium text-black transition hover:bg-zinc-200 disabled:opacity-50"
              >
                {loading ? "Searching..." : "Live Search"}
              </button>
            </form>

            <div className="flex gap-2">
              <div className="flex items-center gap-2 rounded-xl border border-white/8 bg-black/20 px-3">
                <SlidersHorizontal className="h-4 w-4 text-zinc-600" />
                <select
                  value={chain}
                  onChange={(e) => setChain(e.target.value)}
                  className="h-10 bg-transparent text-sm text-zinc-300 outline-none"
                >
                  <option>All</option>
                  <option>Solana</option>
                  <option>Base</option>
                  <option>Ethereum</option>
                </select>
              </div>

              <select
                value={risk}
                onChange={(e) => setRisk(e.target.value)}
                className="h-10 rounded-xl border border-white/8 bg-[#0e1118] px-3 text-sm text-zinc-300 outline-none"
              >
                <option>All</option>
                <option>Low</option>
                <option>Medium</option>
                <option>High</option>
              </select>
            </div>
          </div>

          <div className="overflow-x-auto">
            <table className="w-full min-w-[1050px] border-collapse text-left text-sm">
              <thead className="text-xs uppercase tracking-[0.08em] text-zinc-600">
                <tr className="border-b border-white/8">
                  <th className="px-4 py-3 font-medium">Token</th>
                  <th className="px-4 py-3 font-medium">Score</th>
                  <th className="px-4 py-3 font-medium">Risk</th>
                  <th className="px-4 py-3 font-medium">Age</th>
                  <th className="px-4 py-3 font-medium">Market Cap</th>
                  <th className="px-4 py-3 font-medium">Liquidity</th>
                  <th className="px-4 py-3 font-medium">5M Volume</th>
                  <th className="px-4 py-3 font-medium">Buys / Sells</th>
                  <th className="px-4 py-3 font-medium">5M</th>
                  <th className="px-4 py-3 font-medium"></th>
                </tr>
              </thead>
              <tbody>
                {tokens.map((token: MemeToken) => (
                  <tr key={token.address} className="border-b border-white/5 hover:bg-white/[0.025]">
                    <td className="px-4 py-4">
                      <div className="font-medium text-white">{token.symbol}</div>
                      <div className="text-xs text-zinc-600">
                        {token.name} · {token.chain}
                      </div>
                    </td>
                    <td className="px-4 py-4">
                      <span className="rounded-lg border border-emerald-400/20 bg-emerald-400/10 px-2 py-1 font-semibold text-emerald-300">
                        {token.score}
                      </span>
                    </td>
                    <td className="px-4 py-4 text-zinc-300">{token.risk}</td>
                    <td className="px-4 py-4 text-zinc-400">{age(token.ageMinutes)}</td>
                    <td className="px-4 py-4 text-zinc-300">{money(token.marketCap)}</td>
                    <td className="px-4 py-4 text-zinc-300">{money(token.liquidity)}</td>
                    <td className="px-4 py-4 text-zinc-300">{money(token.volume5m)}</td>
                    <td className="px-4 py-4 text-zinc-400">
                      {token.buys5m} / {token.sells5m}
                    </td>
                    <td className={`px-4 py-4 ${token.priceChange5m >= 0 ? "text-emerald-300" : "text-rose-300"}`}>
                      {pct(token.priceChange5m)}
                    </td>
                    <td className="px-4 py-4">
                      <Link
                        href={`/token/${token.address}`}
                        className="inline-flex items-center gap-1 text-xs text-zinc-400 hover:text-white"
                      >
                        Analyze
                        <ArrowUpRight className="h-3.5 w-3.5" />
                      </Link>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        {liveMessage ? (
          <section className="rounded-2xl border border-white/8 bg-white/[0.025] p-4">
            <div className="mb-3 text-sm text-zinc-400">{liveMessage}</div>
            {livePairs.length > 0 ? (
              <div className="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
                {livePairs.map((pair, index) => {
                  const buys = pair.txns?.m5?.buys ?? 0;
                  const sells = pair.txns?.m5?.sells ?? 0;
                  return (
                    <a
                      key={`${pair.pairAddress}-${index}`}
                      href={pair.url}
                      target="_blank"
                      rel="noreferrer"
                      className="rounded-xl border border-white/8 bg-black/20 p-4 transition hover:border-emerald-400/30"
                    >
                      <div className="text-xs text-zinc-600">
                        {pair.chainId || "unknown"}
                      </div>
                      <div className="mt-1 font-medium text-white">
                        {pair.baseToken?.symbol || "TOKEN"}
                      </div>
                      <div className="mt-3 grid grid-cols-2 gap-2 text-xs">
                        <div>
                          <div className="text-zinc-600">MC</div>
                          <div className="text-zinc-300">
                            {money(pair.marketCap ?? pair.fdv ?? 0)}
                          </div>
                        </div>
                        <div>
                          <div className="text-zinc-600">Liquidity</div>
                          <div className="text-zinc-300">
                            {money(pair.liquidity?.usd ?? 0)}
                          </div>
                        </div>
                        <div>
                          <div className="text-zinc-600">5m Vol</div>
                          <div className="text-zinc-300">
                            {money(pair.volume?.m5 ?? 0)}
                          </div>
                        </div>
                        <div>
                          <div className="text-zinc-600">B/S</div>
                          <div className="text-zinc-300">
                            {buys}/{sells}
                          </div>
                        </div>
                      </div>
                    </a>
                  );
                })}
              </div>
            ) : null}
          </section>
        ) : null}
      </div>
    </AppShell>
  );
}