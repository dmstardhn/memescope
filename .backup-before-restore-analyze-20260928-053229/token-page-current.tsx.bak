"use client";

import {
  useParams,
} from "next/navigation";

import {
  TokenMarketTerminal,
} from "@/components/token-market-terminal";

export default function TokenPage() {
  const params =
    useParams<{
      address: string;
    }>();

  return (
    <TokenMarketTerminal
      address={
        params.address
      }
    />
  );
}