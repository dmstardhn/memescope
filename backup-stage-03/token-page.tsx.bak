"use client";

import { AppShell } from "@/components/app-shell";
import { StatCard } from "@/components/stat-card";
import { money, pct } from "@/lib/format";
import { mockTokens } from "@/lib/mock-data";
import { AlertTriangle, ArrowLeft, CheckCircle2, ShieldCheck, Zap } from "lucide-react";
import Link from "next/link";
import { useParams } from "next/navigation";

export default function TokenPage() {
  const params = useParams<{ address: string }>();
  const token = mockTokens.find((item) => item.address === params.address) ?? mockTokens[0];
  const buySellRatio = token.sells5m === 0 ? token.buys5m : token.buys5m / token.sells5m;

  const metrics = [
    ["Momentum", token.momentum],
    ["Activity", token.activity],
    ["Liquidity", token.liquidityScore],
    ["Safety", token.safety],
  ] as const;

  return (
    <AppShell>
      <div className="border-b border-white/8 px-5 py-5 lg:px-8">
        <Link href="/scanner" className="mb-4 inline-flex items-center gap-2 text-sm text-zinc-500 hover:text-white">
          <ArrowLeft className="h-4 w-4" />
          Back to scanner
        </Link>

        <div className="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <div className="text-sm text-zinc-500">{token.chain} · {token.address}</div>
            <h1 className="mt-1 text-3xl font-semibold tracking-tight text-white">
              {token.name} <span className="text-zinc-600">${token.symbol}</span>
            </h1>
          </div>
          <div className="flex items-center gap-3">
            <div className="rounded-xl border border-white/8 px-4 py-3">
              <div className="text-xs text-zinc-600">Risk</div>
              <div className="font-medium text-white">{token.risk}</div>
            </div>
            <div className="rounded-xl border border-emerald-400/20 bg-emerald-400/10 px-4 py-3">
              <div className="text-xs text-emerald-300/70">MemeScope Score</div>
              <div className="text-2xl font-semibold text-emerald-300">{token.score}/100</div>
            </div>
          </div>
        </div>
      </div>

      <div className="space-y-6 p-5 lg:p-8">
        <section className="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
          <StatCard label="Market Cap" value={money(token.marketCap)} />
          <StatCard label="Liquidity" value={money(token.liquidity)} />
          <StatCard label="5M Volume" value={money(token.volume5m)} />
          <StatCard label="5M Price" value={pct(token.priceChange5m)} />
        </section>

        <section className="grid gap-4 xl:grid-cols-[1.35fr_.65fr]">
          <div className="rounded-2xl border border-white/8 bg-white/[0.025] p-5">
            <h2 className="text-lg font-medium text-white">Quality breakdown</h2>
            <div className="mt-5 space-y-5">
              {metrics.map(([label, value]) => (
                <div key={label}>
                  <div className="mb-2 flex items-center justify-between text-sm">
                    <span className="text-zinc-400">{label}</span>
                    <span className="font-medium text-white">{value}/100</span>
                  </div>
                  <div className="h-2 overflow-hidden rounded-full bg-white/5">
                    <div
                      className="h-full rounded-full bg-emerald-300"
                      style={{ width: `${value}%` }}
                    />
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div className="rounded-2xl border border-white/8 bg-white/[0.025] p-5">
            <h2 className="text-lg font-medium text-white">Market signals</h2>
            <div className="mt-5 space-y-3">
              <div className="rounded-xl border border-white/8 bg-black/20 p-4">
                <div className="flex items-center gap-2 text-sm text-emerald-300">
                  <Zap className="h-4 w-4" />
                  Buy pressure
                </div>
                <p className="mt-2 text-sm leading-6 text-zinc-500">
                  5m buy/sell ratio is {buySellRatio.toFixed(2)}x with {token.buys5m} buys
                  and {token.sells5m} sells.
                </p>
              </div>

              <div className="rounded-xl border border-white/8 bg-black/20 p-4">
                <div className="flex items-center gap-2 text-sm text-zinc-300">
                  <ShieldCheck className="h-4 w-4" />
                  Security layer
                </div>
                <p className="mt-2 text-sm leading-6 text-zinc-500">
                  Contract authority, LP status, holder concentration and deployer history
                  will be connected through chain-specific providers.
                </p>
              </div>

              {token.risk === "High" ? (
                <div className="rounded-xl border border-rose-400/20 bg-rose-400/5 p-4">
                  <div className="flex items-center gap-2 text-sm text-rose-300">
                    <AlertTriangle className="h-4 w-4" />
                    Extra verification required
                  </div>
                </div>
              ) : (
                <div className="rounded-xl border border-white/8 bg-black/20 p-4">
                  <div className="flex items-center gap-2 text-sm text-zinc-300">
                    <CheckCircle2 className="h-4 w-4" />
                    No high-risk flag in demo model
                  </div>
                </div>
              )}
            </div>
          </div>
        </section>

        <div className="rounded-2xl border border-amber-400/15 bg-amber-400/5 p-4 text-sm leading-6 text-amber-100/70">
          Scores in this foundation build are demo analytics, not investment advice or a
          prediction of future price performance.
        </div>
      </div>
    </AppShell>
  );
}