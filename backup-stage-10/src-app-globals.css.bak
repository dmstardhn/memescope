@import "tailwindcss";

:root {
  color-scheme: dark;
}

* {
  box-sizing: border-box;
}

html {
  background: #080a0f;
}

body {
  margin: 0;
  background:
    radial-gradient(circle at 80% -20%, rgba(52, 211, 153, 0.08), transparent 28rem),
    #080a0f;
  color: #f4f4f5;
  font-family: Arial, Helvetica, sans-serif;
}

button,
input,
select {
  font: inherit;
}

::selection {
  background: rgba(52, 211, 153, 0.28);
}