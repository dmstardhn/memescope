# DEX Screener public endpoints do not require an API key.

# Solana HTTP RPC.
# Empty = public Solana RPC for local development.
SOLANA_RPC_URL=

# Solana WebSocket RPC.
# Empty = wss://api.mainnet.solana.com/
# For production, use the WSS endpoint from the same private RPC provider.
SOLANA_WSS_URL=

# Optional PumpPortal direct stream.
PUMPPORTAL_API_KEY=

# Future:
EVM_RPC_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AI_API_KEY=
