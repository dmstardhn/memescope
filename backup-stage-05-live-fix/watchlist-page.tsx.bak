import { AppShell } from "@/components/app-shell";
import { money } from "@/lib/format";
import { mockTokens } from "@/lib/mock-data";
import Link from "next/link";

export default function WatchlistPage() {
  const tokens = mockTokens.slice(0, 3);

  return (
    <AppShell>
      <div className="border-b border-white/8 px-5 py-5 lg:px-8">
        <div className="text-sm text-emerald-300">Saved Research</div>
        <h1 className="mt-1 text-3xl font-semibold tracking-tight text-white">Watchlist</h1>
      </div>
      <div className="grid gap-3 p-5 md:grid-cols-2 xl:grid-cols-3 lg:p-8">
        {tokens.map((token) => (
          <Link
            key={token.address}
            href={`/token/${token.address}`}
            className="rounded-2xl border border-white/8 bg-white/[0.025] p-5 transition hover:border-emerald-400/25"
          >
            <div className="text-xs text-zinc-600">{token.chain}</div>
            <div className="mt-1 text-xl font-medium text-white">${token.symbol}</div>
            <div className="mt-5 grid grid-cols-3 gap-3 text-sm">
              <div>
                <div className="text-xs text-zinc-600">Score</div>
                <div className="mt-1 text-emerald-300">{token.score}</div>
              </div>
              <div>
                <div className="text-xs text-zinc-600">MC</div>
                <div className="mt-1 text-zinc-300">{money(token.marketCap)}</div>
              </div>
              <div>
                <div className="text-xs text-zinc-600">Risk</div>
                <div className="mt-1 text-zinc-300">{token.risk}</div>
              </div>
            </div>
          </Link>
        ))}
      </div>
    </AppShell>
  );
}